{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "ignoreUnknown": false, "includes": ["**", "!**/dist", "!**/coverage"] },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off"
      },
      "style": {
        "noUselessElse": "off",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  }
}
